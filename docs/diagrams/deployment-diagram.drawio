        </mxCell>
        <mxCell id="webui" value="«artifact»&lt;br&gt;&lt;b&gt;BrewLite Web UI Client&lt;/b&gt;&lt;br&gt;&lt;br&gt;• React 18.3, TailwindCSS 3.4&lt;br&gt;• Zustand Store &amp;amp; &lt;i&gt;lib/api.ts&lt;/i&gt; (JWT Refresh)&lt;br&gt;• Mobile-First UI + &lt;i&gt;manifest.webmanifest&lt;/i&gt;&lt;br&gt;• Sinh &lt;i&gt;crypto.randomUUID()&lt;/i&gt; &lt;i&gt;Idempotency-Key&lt;/i&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=10.5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" parent="browser" vertex="1">
          <mxGeometry x="14" y="60" width="212" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="mbbank_client" value="«artifact»&lt;br&gt;&lt;b&gt;MBBank VietQR Client&lt;/b&gt;&lt;br&gt;• Đường dẫn: &lt;i&gt;/mbbank&lt;/i&gt;, &lt;i&gt;/mbbank/admin&lt;/i&gt;&lt;br&gt;• Quét QR Camera (&lt;i&gt;jsQR / html5-qrcode&lt;/i&gt;)&lt;br&gt;• POST &lt;i&gt;/api/payments/mbbank-sync&lt;/i&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=10.5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" parent="browser" vertex="1">
          <mxGeometry x="14" y="244" width="212" height="108" as="geometry"/>
        </mxCell>
        <mxCell id="vps" value="&lt;b&gt;Production Container Host / Cloud VPS (Ubuntu 22.04)&lt;/b&gt;&lt;br&gt;«device» Stack Docker Compose: &lt;i&gt;docker-compose.yml&lt;/i&gt; (name: &lt;i&gt;brewlite&lt;/i&gt;) — Hoặc PaaS tùy chọn: Vercel (Web) + Render (&lt;i&gt;render.yaml&lt;/i&gt;)" style="shape=cube;boundedLbl=1;backgroundOutline=1;darkOpacity=0;darkOpacity2=0;size=14;verticalAlign=top;spacingTop=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=12.5;fontFamily=Helvetica;align=left;spacingLeft=12;" parent="1" vertex="1">
          <mxGeometry x="390" y="265" width="1230" height="660" as="geometry"/>
        </mxCell>
        <mxCell id="docker" value="&lt;b&gt;Docker Engine 24+&lt;/b&gt; «executionEnvironment» — Mạng nội bộ: &lt;b&gt;brewlite_network&lt;/b&gt; (Build local &lt;i&gt;./apps/*&lt;/i&gt; hoặc Pull GHCR)" style="shape=cube;boundedLbl=1;backgroundOutline=1;darkOpacity=0;darkOpacity2=0;size=12;verticalAlign=top;spacingTop=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=12;fontFamily=Helvetica;align=left;spacingLeft=10;" parent="vps" vertex="1">
          <mxGeometry x="22" y="68" width="1190" height="578" as="geometry"/>
        </mxCell>
        <mxCell id="c_frontend" value="&lt;b&gt;Container: brewlite_frontend&lt;/b&gt;&lt;br&gt;«container» node:20-alpine | Port: 3000" style="shape=cube;boundedLbl=1;backgroundOutline=1;darkOpacity=0;darkOpacity2=0;size=10;verticalAlign=top;spacingTop=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;fontFamily=Helvetica;" parent="docker" vertex="1">
          <mxGeometry x="16" y="58" width="268" height="504" as="geometry"/>
        </mxCell>
        <mxCell id="fe_app" value="«artifact» &lt;b&gt;brewlite-frontend&lt;/b&gt;&lt;br&gt;Next.js 14.2.5 (App Router) | &lt;i&gt;npm start&lt;/i&gt;&lt;br&gt;• 13 Client Pages ('use client'):&lt;br&gt;&amp;nbsp;&amp;nbsp;/, /products/[id], /cart, /checkout, /orders,&lt;br&gt;&amp;nbsp;&amp;nbsp;/orders/[id], /orders/me, /orders/history,&lt;br&gt;&amp;nbsp;&amp;nbsp;/login, /register, /profile, /staff, /admin&lt;br&gt;• Redirect: /products → / | Static: /mbbank, /mbbank/admin" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=10.5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;" parent="c_frontend" vertex="1">
          <mxGeometry x="14" y="66" width="230" height="192" as="geometry"/>
        </mxCell>
        <mxCell id="fe_proxy" value="&lt;b&gt;Next.js Route Handlers &amp;amp; Rewrites&lt;/b&gt;&lt;br&gt;• Handlers: &lt;i&gt;mbbank-sync&lt;/i&gt;, &lt;i&gt;mbbank-check/[orderCode]&lt;/i&gt;&lt;br&gt;• Rewrites: &lt;i&gt;/mbbank&lt;/i&gt;, &lt;i&gt;/mbbank/admin&lt;/i&gt; → &lt;i&gt;.html&lt;/i&gt;&lt;br&gt;• Rewrite &lt;i&gt;/api/:path*&lt;/i&gt; → &lt;i&gt;INTERNAL_BACKEND_URL&lt;/i&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;(&lt;i&gt;http://backend:3001/api/:path*&lt;/i&gt;)" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=10.5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;" parent="c_frontend" vertex="1">
          <mxGeometry x="14" y="268" width="230" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="fe_env" value="&lt;b&gt;Frontend Env Config&lt;/b&gt;&lt;br&gt;PORT=3000, NODE_ENV=production&lt;br&gt;NEXT_PUBLIC_API_URL&lt;br&gt;INTERNAL_BACKEND_URL" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;" parent="c_frontend" vertex="1">
          <mxGeometry x="14" y="398" width="230" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="c_backend" value="&lt;b&gt;Container: brewlite_backend&lt;/b&gt; «container»&lt;br&gt;node:20-alpine | Port: 3001 (0.0.0.0) | Swagger: /api/docs" style="shape=cube;boundedLbl=1;backgroundOutline=1;darkOpacity=0;darkOpacity2=0;size=10;verticalAlign=top;spacingTop=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=12;fontFamily=Helvetica;" parent="docker" vertex="1">
          <mxGeometry x="366" y="58" width="482" height="504" as="geometry"/>
        </mxCell>
        <mxCell id="mainjs" value="&lt;b&gt;dist/src/main.js&lt;/b&gt; (NestJS 10.3)&lt;br&gt;CMD: prisma db push → seed → node&lt;br&gt;Global /api • CORS • ValidationPipe&lt;br&gt;AllExceptionsFilter • TransformInterceptor" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=10.5;fontFamily=Helvetica;align=center;verticalAlign=middle;" parent="c_backend" vertex="1">
          <mxGeometry x="14" y="66" width="218" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="prisma" value="&lt;b&gt;Prisma Client ORM 5.9&lt;/b&gt;&lt;br&gt;DB Connection Pool (PostgreSQL Pool)&lt;br&gt;&lt;i&gt;$transaction()&lt;/i&gt; + OCC Version Checks&lt;br&gt;&amp;amp; &lt;i&gt;FallbackStore&lt;/i&gt; (In-Memory Resiliency)" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=10.5;fontFamily=Helvetica;align=center;verticalAlign=middle;" parent="c_backend" vertex="1">
          <mxGeometry x="246" y="66" width="212" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="core" value="&lt;b&gt;8 NestJS Feature Modules &amp;amp; Internal Mock Gateway&lt;/b&gt;&lt;br&gt;• &lt;b&gt;AuthModule&lt;/b&gt; (JWT 15m/7d, Bcryptjs 10) • &lt;b&gt;ProductsModule&lt;/b&gt; (Menu, Toppings, Check Kho)&lt;br&gt;• &lt;b&gt;OrdersModule&lt;/b&gt; (State Machine) • &lt;b&gt;PromotionsModule&lt;/b&gt; • &lt;b&gt;ReviewsModule&lt;/b&gt;&lt;br&gt;• &lt;b&gt;PaymentModule&lt;/b&gt; (Idempotency-Key, OCC, &lt;i&gt;mbbank-sync/-check/-invalidate&lt;/i&gt;, &lt;b&gt;MockGatewayService&lt;/b&gt; &amp;amp; &lt;i&gt;/api/mock-gateway/charge&lt;/i&gt;)&lt;br&gt;• &lt;b&gt;StaffModule&lt;/b&gt; (Kanban FIFO, Order Recipes) • &lt;b&gt;AdminModule&lt;/b&gt; (Kho, Công thức, NCC, Báo cáo)" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=10.5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;" parent="c_backend" vertex="1">
          <mxGeometry x="14" y="188" width="444" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="obs" value="&lt;b&gt;Health Check &amp;amp; Observability&lt;/b&gt;&lt;br&gt;GET /api/health &amp;amp; /health (200 OK)&lt;br&gt;&lt;i&gt;SELECT 1&lt;/i&gt; DB Ping + Uptime + Version JSON&lt;br&gt;AllExceptionsFilter (Logger &amp;amp; Error JSON)" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=10.5;fontFamily=Helvetica;align=center;verticalAlign=middle;" parent="c_backend" vertex="1">
