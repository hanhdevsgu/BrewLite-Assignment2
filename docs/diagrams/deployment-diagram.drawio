        <mxCell id="browser" value="&lt;b&gt;Trình duyệt Web (Mobile-First)&lt;/b&gt;&lt;br&gt;«executionEnvironment»" style="shape=cube;boundedLbl=1;backgroundOutline=1;darkOpacity=0;darkOpacity2=0;size=10;verticalAlign=top;spacingTop=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;fontFamily=Helvetica;" parent="device" vertex="1">
