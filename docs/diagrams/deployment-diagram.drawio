<?xml version="1.0" ?>
<mxfile host="app.diagrams.net">
  <diagram id="brewlite-deployment" name="Deployment - BrewLite">
    <mxGraphModel dx="1640" dy="1250" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="edge_proxy" value="&lt;b&gt;Edge CDN &amp;amp; HTTPS Reverse Proxy&lt;/b&gt;&lt;br&gt;«cloud / edge» Cloudflare Tunnel / Reverse Proxy" style="shape=cube;boundedLbl=1;backgroundOutline=1;darkOpacity=0;darkOpacity2=0;size=12;verticalAlign=top;spacingTop=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=12;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="20" y="20" width="410" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="edge_artifact" value="&lt;b&gt;TLS 1.3 Termination — Public Port: 443 (HTTPS)&lt;/b&gt;&lt;br&gt;• Forward Web UI &amp;amp; /api/* → &lt;i&gt;brewlite_frontend (:3000)&lt;/i&gt;&lt;br&gt;• Dev/Demo Edge: &lt;i&gt;scripts/tunnel.js&lt;/i&gt; (&lt;i&gt;*.trycloudflare.com&lt;/i&gt;) / PaaS Edge&lt;br&gt;• Prod Security: Chặn public Port 5432 &amp;amp; 3001 qua Firewall/Proxy" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;" parent="edge_proxy" vertex="1">
          <mxGeometry x="18" y="68" width="362" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="cicd" value="&lt;b&gt;CI/CD Pipeline &amp;amp; Container Registry&lt;/b&gt;&lt;br&gt;«infrastructure» GitHub Actions (.github/workflows/ci.yml, cd.yml) + GHCR" style="shape=cube;boundedLbl=1;backgroundOutline=1;darkOpacity=0;darkOpacity2=0;size=12;verticalAlign=top;spacingTop=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=12;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="595" y="20" width="1025" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="gh_actions" value="&lt;b&gt;GitHub Actions Runner&lt;/b&gt; (&lt;i&gt;ubuntu-latest&lt;/i&gt;)&lt;br&gt;• &lt;b&gt;ci.yml&lt;/b&gt; (PR develop/main, push develop): &lt;i&gt;postgres:16-alpine&lt;/i&gt;, lint (tsc/eslint), &lt;b&gt;prisma migrate deploy&lt;/b&gt;, seed, Jest Unit &amp;amp; test:e2e, build&lt;br&gt;• &lt;b&gt;cd.yml&lt;/b&gt; (push main/v*.*.*, dispatch): Quality Gate (lint, Unit, build) → Push GHCR → prisma validate/migrate → Hook / Compose Smoke Test&lt;br&gt;• &lt;b&gt;Failure handler:&lt;/b&gt; Dọn Compose (&lt;i&gt;docker compose down -v&lt;/i&gt;) &amp;amp; tham chiếu &lt;i&gt;docs/rollback-guide.md&lt;/i&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=10.5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;" parent="cicd" vertex="1">
          <mxGeometry x="20" y="60" width="575" height="108" as="geometry"/>
        </mxCell>
        <mxCell id="ghcr" value="&lt;b&gt;Container Registry&lt;/b&gt;&lt;br&gt;«registry» &lt;b&gt;ghcr.io&lt;/b&gt;&lt;br&gt;• brewlite-web:&amp;lt;SHORT_SHA | main | v*.*.*&amp;gt;&lt;br&gt;• brewlite-api:&amp;lt;SHORT_SHA | main | v*.*.*&amp;gt;" style="shape=cube;boundedLbl=1;backgroundOutline=1;darkOpacity=0;darkOpacity2=0;size=10;verticalAlign=top;spacingTop=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;fontFamily=Helvetica;" parent="cicd" vertex="1">
          <mxGeometry x="670" y="60" width="335" height="108" as="geometry"/>
        </mxCell>
