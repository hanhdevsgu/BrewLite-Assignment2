        <mxCell id="device" value="&lt;b&gt;Thiết bị Người dùng&lt;/b&gt;&lt;br&gt;«device» [Laptop, PC, Smartphone]" style="shape=cube;boundedLbl=1;backgroundOutline=1;darkOpacity=0;darkOpacity2=0;size=12;verticalAlign=top;spacingTop=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=12;fontFamily=Helvetica;" parent="1" vertex="1">
