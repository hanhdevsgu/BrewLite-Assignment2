<mxfile host="app.diagrams.net">
  <diagram id="BrewLite_Subsystem_Account_Menu" name="Phan-He-Tai-Khoan-Thuc-Don-Gio-Hang">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="960" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- System Boundary -->
        <mxCell id="sys" parent="1" style="swimlane;collapsible=0;startSize=30;fillColor=none;strokeColor=#000000;fontColor=#000000;fontSize=13;fontStyle=1;whiteSpace=wrap;" value="Phân Hệ Tài Khoản, Thực Đơn &amp; Giỏ Hàng" vertex="1">
          <mxGeometry height="680" width="620" x="300" y="40" as="geometry" />
        </mxCell>

        <!-- Actors Column 1 (Left: Admin, Barista, Customer) -->
        <mxCell id="aAdm" parent="1" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=11;strokeColor=#000000;fontColor=#000000;fillColor=#FFFFFF;" value="Quản trị viên&lt;br&gt;(Admin)" vertex="1">
          <mxGeometry height="60" width="30" x="35" y="80" as="geometry" />
        </mxCell>

        <mxCell id="aBar" parent="1" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=11;strokeColor=#000000;fontColor=#000000;fillColor=#FFFFFF;" value="Nhân viên pha chế&lt;br&gt;(Barista)" vertex="1">
          <mxGeometry height="60" width="30" x="35" y="210" as="geometry" />
        </mxCell>

        <mxCell id="aCus" parent="1" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=11;strokeColor=#000000;fontColor=#000000;fillColor=#FFFFFF;" value="Khách hàng&lt;br&gt;(Customer)" vertex="1">
          <mxGeometry height="60" width="30" x="35" y="460" as="geometry" />
        </mxCell>

        <!-- Actor Column 2 (User) -->
        <mxCell id="aGen" parent="1" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=11;strokeColor=#000000;fontColor=#000000;fillColor=#FFFFFF;" value="«Abstract»&lt;br&gt;Người dùng chung&lt;br&gt;(User)" vertex="1">
          <mxGeometry height="60" width="30" x="175" y="210" as="geometry" />
        </mxCell>

        <!-- Generalization Tree: Balanced unified fork centered on User -->
        <mxCell id="bus" edge="1" parent="1" style="endArrow=none;html=1;strokeColor=#000000;rounded=0;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="115" y="100" as="sourcePoint" />
            <mxPoint x="115" y="480" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="bAdm" edge="1" parent="1" source="aAdm" style="endArrow=none;html=1;strokeColor=#000000;exitX=1;exitY=0.33;exitDx=0;exitDy=0;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="115" y="100" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="bBar" edge="1" parent="1" source="aBar" style="endArrow=none;html=1;strokeColor=#000000;exitX=1;exitY=0.33;exitDx=0;exitDy=0;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="115" y="230" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="bCus" edge="1" parent="1" source="aCus" style="endArrow=none;html=1;strokeColor=#000000;exitX=1;exitY=0.33;exitDx=0;exitDy=0;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="115" y="480" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Single Generalization Arrow from Bus into User -->
        <mxCell id="stem" edge="1" parent="1" target="aGen" style="endArrow=block;endFill=0;endSize=11;html=1;strokeColor=#000000;entryX=0;entryY=0.33;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="115" y="230" as="sourcePoint" />
          </mxGeometry>
        </mxCell>

        <!-- User Use Cases (Top Section) -->
