        <mxCell id="u3" parent="1" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;strokeColor=#000000;fontColor=#000000;fillColor=#FFFFFF;" value="UC-03: Đổi mật khẩu" vertex="1">
