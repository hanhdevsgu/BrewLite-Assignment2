@startuml class-diagram
title Sơ đồ Lớp Thực Thể (Domain Class Diagram) - BrewLite Coffee
skinparam classAttributeIconSize 0
skinparam backgroundColor #FFFFFF

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  PREPARING
  READY
  COMPLETED
  CANCELLED
  PAYMENT_FAILED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  MOCK_WALLET
  BANK_TRANSFER
  CREDIT_CARD
}

class User {
  - id: UUID
  - username: String
  - passwordHash: String
  - fullName: String
  - email: String
  - phone: String
  - role: Role
  - loyaltyPoints: Integer
  - isActive: Boolean
  - createdAt: DateTime
  + verifyPassword(plainPassword): Boolean
  + updateProfile(name, phone): Void
  + addPoints(points): Void
}

class Product {
  - id: UUID
  - name: String
  - description: String
  - category: String
  - imageUrl: String
  - isActive: Boolean
  - createdAt: DateTime
  + getAvailableVariants(): List<ProductVariant>
  + getAverageRating(): Float
}

class ProductVariant {
  - id: UUID
  - productId: UUID
  - size: String
  - price: Decimal
  - topping: String
}

class Ingredient {
  - id: UUID
  - name: String
  - unit: String
  - stockQuantity: Decimal
  - version: Integer
  + deductStock(amount, currentVersion): Boolean
}

class Recipe {
  - id: UUID
  - variantId: UUID
  - ingredientId: UUID
  - quantityRequired: Decimal
}

class Order {
  - id: UUID
  - customerId: UUID
  - orderNumber: String
  - status: OrderStatus
  - totalAmount: Decimal
  - discountAmount: Decimal
  - finalAmount: Decimal
  - createdAt: DateTime
  - updatedAt: DateTime
  + transitionTo(newStatus): Boolean
  + calculateTotal(): Decimal
  + cancel(): Void
}

class OrderItem {
  - id: UUID
  - orderId: UUID
  - variantId: UUID
  - quantity: Integer
  - unitPrice: Decimal
  - subtotal: Decimal
}

class Payment {
  - id: UUID
  - orderId: UUID
  - idempotencyKey: String
  - method: PaymentMethod
  - status: PaymentStatus
  - amount: Decimal
  - transactionRef: String
  - createdAt: DateTime
  + isReplayed(key): Boolean
  + markSuccess(): Void
}

class Promotion {
  - id: UUID
  - code: String
  - description: String
  - discountPercent: Integer
  - maxDiscount: Decimal
  - minOrderValue: Decimal
  - validFrom: DateTime
  - validTo: DateTime
  - isActive: Boolean
  + isValid(orderTotal): Boolean
  + calculateDiscount(orderTotal): Decimal
}

class LoyaltyTransaction {
  - id: UUID
  - userId: UUID
  - orderId: UUID
  - pointsChanged: Integer
  - balanceAfter: Integer
  - reason: String
  - createdAt: DateTime
}

class Review {
  - id: UUID
  - userId: UUID
  - productId: UUID
  - rating: Integer
  - comment: String
  - createdAt: DateTime
}

' Relationships & Multiplicity
User "1" -- "0..*" Order : places >
User "1" -- "0..*" Review : writes >
User "1" -- "0..*" LoyaltyTransaction : owns >

Product "1" -- "1..*" ProductVariant : has >
Product "1" -- "0..*" Review : receives >

ProductVariant "1" -- "0..*" OrderItem : specified in >
ProductVariant "1" -- "1..*" Recipe : requires >
Ingredient "1" -- "0..*" Recipe : used in >

Order "1" -- "1..*" OrderItem : contains >
Order "1" -- "0..1" Payment : settled by >
Order "0..*" -- "0..1" Promotion : applies >
Order "0..1" -- "0..1" LoyaltyTransaction : generates >

@enduml

