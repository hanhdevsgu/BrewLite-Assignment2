@startuml class-diagram
title Sơ đồ Lớp Thực Thể CSDL Cốt Lõi (Domain Class Diagram) - BrewLite Coffee
skinparam classAttributeIconSize 0
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam linetype ortho

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

enum AccountStatus {
  ACTIVE
  LOCKED
}

enum OrderStatus {
  PENDING
  PAID
  PREPARING
  READY
  COMPLETED
  PAYMENT_FAILED
  CANCELLED
}

enum PaymentStatus {
  SUCCESS
  FAILED
}

enum PaymentMethod {
  WALLET
  CARD
}

enum PromotionType {
  PERCENT
  FIXED
}

enum ReviewStatus {
  VISIBLE
  HIDDEN
}

class Account {
  + id: String [PK, UUID]
  + username: String [Unique]
  + passwordHash: String
  + role: Role
  + status: AccountStatus
  + createdAt: DateTime
  + updatedAt: DateTime
}

class Customer {
  + id: String [PK, UUID]
  + accountId: String [FK, Unique]
  + fullName: String
  + email: String [Unique]
  + loyaltyPoints: Int = 0
  + createdAt: DateTime
  + updatedAt: DateTime
  + addLoyaltyPoints(pts: Int): Void
  + refundLoyaltyPoints(pts: Int): Void
}

class Staff {
  + id: String [PK, UUID]
  + accountId: String [FK, Unique]
  + fullName: String
  + email: String
  + createdAt: DateTime
  + updatedAt: DateTime
  + updateOrderStatus(): Void
}

class Admin {
  + id: String [PK, UUID]
  + accountId: String [FK, Unique]
  + fullName: String
  + email: String
  + createdAt: DateTime
  + updatedAt: DateTime
  + manageCatalog(): Void
  + managePromotions(): Void
}

class LoyaltyTransaction <<Logical Domain View>> {
  + id: String [PK, UUID]
  + customerId: String [FK]
  + orderId: String [FK, Nullable]
  + pointsChanged: Int
  + balanceAfter: Int
  + type: String [EARN|REDEEM|REFUND|REVOKE]
  + note: String [Nullable]
  + createdAt: DateTime
}
note bottom of LoyaltyTransaction
  Mô hình domain cho biến động điểm thưởng;
  trong PostgreSQL/Prisma được hiện thực qua
  Customer.loyaltyPoints & OrderStatusHistory.
end note

class Product {
  + id: String [PK, UUID]
  + name: String
  + imageUrl: String
  + description: String [Nullable]
  + category: String = "COFFEE"
  + isActive: Boolean = true
  + createdAt: DateTime
  + updatedAt: DateTime
}

class ProductVariant {
  + id: String [PK, UUID]
  + productId: String [FK]
  + size: String [S, M, L]
  + price: Decimal(12,2)
  + topping: String [Nullable]
  + createdAt: DateTime
  + updatedAt: DateTime
}

class Ingredient {
  + id: String [PK, UUID]
  + name: String
  + unit: String
  + stockQuantity: Decimal(12,2)
  + version: Int = 1 [OCC Lock]
  + createdAt: DateTime
  + updatedAt: DateTime
  + deductStock(qty: Decimal, ver: Int): Boolean
  + refundStock(qty: Decimal): Void
}

class Recipe {
  + id: String [PK, UUID]
  + variantId: String [FK]
  + ingredientId: String [FK]
  + quantityRequired: Decimal(12,2)
}

class Supplier {
  + id: String [PK, UUID]
  + name: String
  + phone: String
  + address: String
  + createdAt: DateTime
  + updatedAt: DateTime
}

class ImportReceipt {
  + id: String [PK, UUID]
  + supplierId: String [FK]
  + importDate: DateTime
  + totalAmount: Decimal(12,2)
}

class ImportReceiptItem {
  + id: String [PK, UUID]
  + receiptId: String [FK]
  + ingredientId: String [FK]
  + quantity: Decimal(12,2)
  + unitPrice: Decimal(12,2)
  + lineTotal: Decimal(12,2)
}

class Order {
  + id: String [PK, UUID]
  + customerId: String [FK]
  + staffId: String [FK, Nullable]
  + promotionId: String [FK, Nullable]
  + status: OrderStatus
  + discountAmount: Decimal(12,2)
  + totalAfterDiscount: Decimal(12,2)
  + createdAt: DateTime
  + updatedAt: DateTime
  + calculateTotal(): Decimal
  + applyPromotion(promo: Promotion): Void
  + transitionTo(newStatus: OrderStatus): Boolean
  + cancel(): Void
}

class OrderItem {
  + id: Int [PK, AutoIncrement]
  + orderId: String [FK]
  + variantId: String [FK]
  + quantity: Int
  + lineTotal: Decimal(12,2)
}

class Payment {
  + id: String [PK, UUID]
  + orderId: String [FK]
  + idempotencyKey: String [Unique]
  + amount: Decimal(12,2)
  + status: PaymentStatus
  + method: PaymentMethod
  + createdAt: DateTime
  + verifyIdempotency(): Boolean
}

class Promotion {
  + id: String [PK, UUID]
  + code: String [Unique]
  + name: String
  + discountType: PromotionType
  + discountValue: Decimal(12,2)
  + quantity: Int
  + usedCount: Int = 0
  + startDate: DateTime
  + endDate: DateTime
  + status: String = "ACTIVE"
  + createdAt: DateTime
  + updatedAt: DateTime
  + isValid(subtotal: Decimal): Boolean
  + calculateDiscount(subtotal: Decimal): Decimal
}

class Review {
  + id: String [PK, UUID]
  + customerId: String [FK]
  + productId: String [FK]
  + orderId: String [FK]
  + stars: Int [1..5]
  + content: String
  + status: ReviewStatus
  + createdAt: DateTime
}

class OrderStatusHistory {
  + id: String [PK, UUID]
  + orderId: String [FK]
  + fromStatus: OrderStatus
  + toStatus: OrderStatus
  + actorId: String [Nullable]
  + note: String [Nullable]
  + createdAt: DateTime
}

Account "1" -- "0..1" Customer
Account "1" -- "0..1" Staff
Account "1" -- "0..1" Admin

Customer "1" -- "0..*" Order : places
Staff "0..1" -- "0..*" Order : processes
Promotion "0..1" -- "0..*" Order : applies
Customer "1" -- "0..*" LoyaltyTransaction : owns
Order "0..1" -- "0..*" LoyaltyTransaction : generates

Order "1" *-- "1..*" OrderItem : contains
ProductVariant "1" -- "0..*" OrderItem
Order "1" *-- "0..*" Payment : idempotent
Order "1" *-- "0..*" OrderStatusHistory : logs

Product "1" *-- "1..*" ProductVariant : has
ProductVariant "1" -- "0..*" Recipe : requires
Ingredient "1" -- "0..*" Recipe : used in

Customer "1" -- "0..*" Review : writes
Product "1" -- "0..*" Review : receives
Order "1" -- "0..*" Review : verified by

Supplier "1" -- "0..*" ImportReceipt
ImportReceipt "1" *-- "1..*" ImportReceiptItem
Ingredient "1" -- "0..*" ImportReceiptItem
@enduml
