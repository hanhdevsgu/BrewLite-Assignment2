@startuml
' ============================================================
' ACTIVITY DIAGRAM – BrewLite (đặt hàng, thanh toán, pha chế)
' ============================================================
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam conditionStyle diamond        ' decision = hình thoi (chuẩn UML)
skinparam conditionEndStyle diamond     ' merge   = hình thoi
skinparam ArrowColor #334155
skinparam ActivityBorderColor #64748B
skinparam ActivityBackgroundColor #F8FAFC
skinparam ActivityDiamondBorderColor #64748B
skinparam ActivityDiamondBackgroundColor #FFFFFF
skinparam swimlaneWidth same

title BrewLite - End-to-End Customer Order, Payment & Fulfillment Activity Diagram

' ---- Khai báo thứ tự lane: Customer đứng giữa, kề Barista và Backend;
' ---- Backend kề Cổng thanh toán => các luồng chính không phải cắt ngang lane khác
|Nhân viên quầy (Barista)|
|Khách hàng (Customer)|
|Hệ thống Backend|
|Cổng thanh toán|

|Khách hàng (Customer)|
start
:1. Mở Web App BrewLite;

|Hệ thống Backend|
:2. Truy vấn Menu & Topping
(GET /api/products, /toppings)
và chi tiết (GET /api/products/:id);

|Khách hàng (Customer)|
:3. Xem thực đơn, tìm kiếm, lọc danh mục,
xem chi tiết món (cờ hết hàng theo size);
:4. Chọn món còn hàng (khóa nếu isOutOfStock),
chọn Size, Topping & mức đường/đá;
:5. Thêm vào Giỏ hàng (/cart), xem Voucher
(GET /api/promotions/available) & bấm Thanh toán;

if (Đã đăng nhập?) then ([Đã đăng nhập])
else ([Chưa đăng nhập])
  repeat
    |Khách hàng (Customer)|
    :6a. Đăng nhập (username, mật khẩu)
    hoặc Đăng ký;
    |Hệ thống Backend|
    :6b. Xác thực / tạo tài khoản
    & cấp Access + Refresh JWT;
  repeat while (Thông tin hợp lệ?) is ([Không hợp lệ]) not ([Hợp lệ])
  |Khách hàng (Customer)|
endif

:7. Tại /checkout: chọn Ví / Thẻ (VietQR) / 0đ,
áp Voucher / điểm thưởng & bấm Xác nhận;

|Hệ thống Backend|
if (Giỏ hàng & món hợp lệ?
POST /api/orders) then ([Không hợp lệ])
  |Khách hàng (Customer)|
  :Hiển thị lỗi: giỏ hàng rỗng
  hoặc món không tồn tại;
  stop
else ([Hợp lệ])
  |Hệ thống Backend|
  :8. Validate voucher (HTTP 400 nếu sai),
  mở $transaction: trừ điểm đã dùng,
  tạo đơn PENDING + audit log;
endif

repeat
  |Khách hàng (Customer)|
  :9. Thực hiện thanh toán / Thử lại Ví hoặc Thẻ
  (hoặc quét VietQR chờ poll mbbank-check);

  |Hệ thống Backend|
  :10. POST /api/payments:
  kiểm tra JWT & Header Idempotency-Key;

  if (Idempotency-Key đã dùng?) then ([Đã dùng])
    if (Đúng chủ đơn, cùng đơn & method?) then ([Đúng])
      |Khách hàng (Customer)|
      :Hiển thị lại kết quả đã thanh toán
      (HTTP 200, không trừ tiền lần 2);
      stop
    else ([Vi phạm])
      |Khách hàng (Customer)|
      :Hiển thị lỗi khóa Idempotency
      (HTTP 403 / 422);
      stop
    endif
  else ([Chưa dùng])
  endif

  |Hệ thống Backend|
  if (Đúng chủ đơn &
  PENDING / PAYMENT_FAILED?) then ([Không hợp lệ])
    |Khách hàng (Customer)|
    :Hiển thị thông báo lỗi đơn hàng
    (HTTP 403 / 404 / 409);
    stop
  else ([Hợp lệ])
  endif

  |Hệ thống Backend|
  :11. Mở $transaction (ACID):
  trừ kho Optimistic Locking
  (version, retry tối đa 3 lần);

  if (Đủ nguyên liệu &
  không xung đột OCC?) then ([Không đủ])
    |Hệ thống Backend|
    :Rollback $transaction
    & báo xung đột tồn kho (HTTP 409);
    |Khách hàng (Customer)|
    :Hiển thị: Hết nguyên liệu / xung đột!;
  else ([Đủ])
    |Cổng thanh toán|
    :12. Cổng thanh toán xử lý trừ tiền
    (OK / FAIL / TIMEOUT);
    |Hệ thống Backend|
    if (Kết quả từ cổng thanh toán?) then ([FAIL / TIMEOUT])
      :Rollback $transaction trừ kho;
      :TX độc lập: cập nhật PAYMENT_FAILED
      & audit log (HTTP 400 / 408);
      |Khách hàng (Customer)|
      :Hiển thị: Thanh toán thất bại!;
    else ([OK])
      |Hệ thống Backend|
      :13. Commit $transaction (ACID):
      tạo Payment (SUCCESS), đơn -> PAID,
      voucher +1, cộng điểm (1đ/10.000đ), audit log;
    endif
  endif

  |Khách hàng (Customer)|
repeat while (Chưa PAID & khách chọn Thử lại?) is ([Thử lại]) not ([Đã PAID / Hủy])

if (Đơn đã thanh toán?) then ([Chưa thanh toán – khách chọn Hủy])
  |Khách hàng (Customer)|
  :Hủy đơn chưa thanh toán
  (POST /api/orders/:id/cancel);
  |Hệ thống Backend|
  :Kiểm tra chủ đơn & PENDING / PAYMENT_FAILED
  -> CANCELLED + hoàn điểm đã dùng & audit log;
  stop
else ([Đã thanh toán])
endif

|Khách hàng (Customer)|
:14. Màn hình Đặt thành công & Mã đơn (PAID);

if (Hủy đơn trước pha chế?) then ([Hủy])
  |Khách hàng (Customer)|
  :Hủy đơn (POST /api/orders/:id/cancel);
  |Hệ thống Backend|
  if (Đơn còn trạng thái PAID?) then ([Đang PAID])
    |Hệ thống Backend|
    :Hoàn kho, hoàn điểm đã dùng,
    thu hồi điểm đã tích, hoàn voucher
    -> CANCELLED + audit log;
    stop
  else ([Đã PREPARING+])
    |Khách hàng (Customer)|
    :Hiển thị: Đơn đang pha, không thể hủy;
  endif
else ([Không hủy])
endif

|Khách hàng (Customer)|
fork
  :Theo dõi tiến độ đơn
  (polling 2s GET /api/orders/:id);
fork again
  |Nhân viên quầy (Barista)|
  :15. Nhận đơn PAID (Kanban FIFO);
  :16. Bấm Tiếp nhận: PAID -> PREPARING;
  :17. Xem Recipes & Pha chế;
  :18. Pha xong: PREPARING -> READY;
end fork

|Khách hàng (Customer)|
:19. Thông báo: "Đồ uống sẵn sàng!";
:20. Đến quầy xuất trình mã;

|Nhân viên quầy (Barista)|
:21. Đối chiếu mã, giao nước & bấm Hoàn tất:
READY -> COMPLETED;

|Khách hàng (Customer)|
:22. Nhận đồ uống & Thưởng thức;
:23. (Tùy chọn) Đánh giá món
(chỉ đơn COMPLETED — /api/reviews);
stop
@enduml
