@startuml BrewLite_Deployment_Diagram
!theme plain
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam monochrome true
skinparam defaultFontName Helvetica
skinparam defaultFontSize 12
skinparam NodeBorderColor #000000
skinparam NodeBackgroundColor #FFFFFF
skinparam RectangleBorderColor #000000
skinparam RectangleBackgroundColor #FFFFFF
skinparam ArtifactBorderColor #000000
skinparam ArtifactBackgroundColor #FFFFFF
skinparam DatabaseBorderColor #000000
skinparam DatabaseBackgroundColor #FFFFFF
skinparam ArrowColor #000000
skinparam linetype polyline
skinparam nodesep 55
skinparam ranksep 65
top to bottom direction

title BrewLite — Sơ đồ Triển khai Hệ thống (Monochrome UML Deployment Diagram)

node "Edge CDN & HTTPS Reverse Proxy\n<<cloud / edge>> Cloudflare Tunnel / Reverse Proxy" as edge_proxy {
  artifact "TLS 1.3 Termination — Public Port: 443 (HTTPS)\nForward Web UI & /api/* -> brewlite_frontend (:3000)\nRunner: scripts/tunnel.js (*.trycloudflare.com)\nSecurity: Không public Port 5432 DB & Port 3001 nội bộ" as edge_artifact
}

node "CI/CD Pipeline & Container Registry\n<<infrastructure>> GitHub Actions + GHCR" as cicd {
  node "GitHub Actions Runner (ubuntu-latest)" as gh_actions {
    artifact "ci.yml (PR/develop): postgres:16-alpine, lint, prisma push, seed, Jest Unit & test:e2e, build\ncd.yml (main/v*.*.*): Quality Gate -> Build Images -> prisma validate/migrate deploy -> Deploy Hook -> Smoke Test\nFailure handler: docs/rollback-guide.md" as ci_wf
  }
  node "Container Registry\n<<registry>> ghcr.io" as ghcr {
    artifact "brewlite-frontend:<SHORT_SHA | v*.*.*>" as img_fe
    artifact "brewlite-backend:<SHORT_SHA | v*.*.*>" as img_be
  }
}

node "Thiết bị Người dùng\n<<device>> [Laptop, PC, Smartphone]" as device {
  node "Trình duyệt Web (Mobile-First)\n<<executionEnvironment>>" as browser {
    artifact "BrewLite Web UI Client\nReact 18.3, TailwindCSS 3.4\nZustand + lib/api.ts (JWT Refresh)\nMobile-First UI + manifest.webmanifest\nSinh UUID Idempotency-Key" as webui
    artifact "MBBank VietQR Client (/mbbank)\nQuét QR trên Camera điện thoại\nGọi POST /api/payments/mbbank-sync" as mbbank_client
  }
}

node "Production Container Host / Cloud VPS (Ubuntu 22.04)\n<<device>> docker-compose.yml (name: brewlite)" as vps {
  node "Docker Engine 24+\n<<executionEnvironment>> Mạng nội bộ: brewlite_network" as docker {
    node "Container: brewlite_frontend\n<<container>> node:20-alpine | Port: 3000" as c_frontend {
      artifact "brewlite-frontend\nNext.js 14.2.5 (App Router) | npm start\nApp Router Pages ('use client') & Static /mbbank\nRoute Handlers: mbbank-sync, mbbank-check\nRewrite /api/:path* -> INTERNAL_BACKEND_URL\n(http://backend:3001/api/:path*)" as fe_app
    }
    node "Container: brewlite_backend\n<<container>> node:20-alpine | Port: 3001 (0.0.0.0) | Swagger: /api/docs" as c_backend {
      artifact "dist/src/main.js (NestJS 10.3)\nCMD: prisma db push -> seed -> node\nGlobal /api, CORS, ValidationPipe" as mainjs
      artifact "Prisma Client ORM 5.9\nDB Connection Pool\n$transaction() + OCC Version Checks" as prisma
      rectangle "8 NestJS Modules & Internal Mock Gateway\n- AuthModule (JWT 15m/7d, Bcrypt 10)\n- ProductsModule, PromotionsModule, ReviewsModule\n- OrdersModule (State Machine)\n- PaymentModule (Idempotency-Key, OCC, mbbank-sync & MockGatewayService nội bộ)\n- StaffModule (Kanban FIFO), AdminModule" as core
      artifact "Health Check & Logging\nGET /api/health & /health (200 OK, SELECT 1)\nAllExceptionsFilter (Logger & JSON)" as obs
      artifact "Secrets & Env Config\nPORT=3001, DATABASE_URL, FRONTEND_URL\nJWT_SECRET (15m), JWT_REFRESH_SECRET (7d)" as secrets
    }
    node "Container: brewlite_postgres\n<<container>> postgres:16-alpine | Port: 5432 [Internal Only]" as c_postgres {
      database "brewlite_db\n(17 Tables / Models)\npg_isready Healthcheck" as cyl
      node "Persistent Storage Volume\n<<storageVolume>>\nDocker Volume: brewlite_postgres_data\nMount: /var/lib/postgresql/data" as volume
    }
  }
}

node "External Payment Gateway (Production Extension)\n<<externalService>>" as ext_pay {
  artifact "VNPay / MoMo REST API & Webhook (HTTPS :443)\n(MVP hiện dùng MockGatewayService nội bộ trong PaymentModule)" as ext_gw
}

rectangle "Environment Boundaries (Local / CI / Production)" as env_strip {
  rectangle "<<boundary>> Local Development\npostgres:5432 + Host Node (:3001, :3000)\nhoặc npm run docker:all + scripts/tunnel.js / https-proxy.js (:3443)" as env_local
  rectangle "<<boundary>> CI Quality Gate\nGitHub Actions + postgres:16-alpine Service\neslint/tsc -> prisma push -> seed -> Jest Unit & test:e2e -> Build & prisma migrate deploy -> ghcr.io" as env_ci
  rectangle "<<boundary>> Production (Isolated)\nHTTPS :443 Edge -> brewlite_frontend :3000 -> backend :3001 <-> postgres :5432\nbrewlite_network (không public 5432) + Volume brewlite_postgres_data" as env_prod
}

device <--> edge_proxy : HTTPS :443 (TLS 1.3)\nWeb UI, /mbbank, /api/* + Idempotency-Key
edge_proxy --> c_frontend : HTTP Proxy -> Port 3000
gh_actions ..> ghcr : docker push
ghcr ..> docker : docker pull images
gh_actions ..> c_backend : Deploy Hook & GET /api/health
c_frontend --> c_backend : Internal HTTP :3001 (/api/:path*)
mainjs --> core
core <--> prisma
c_backend <--> c_postgres : TCP/IP :5432 (Internal Only)
cyl --> volume : WAL / Data Persist
core <..> ext_gw : <<future>> HTTPS REST/Webhook (:443)

@enduml
