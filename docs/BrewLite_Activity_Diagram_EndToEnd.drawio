<mxCell id="c105" value="16. Bấm Tiếp nhận:&lt;br&gt;PAID → PREPARING" style="rounded=1;absoluteArcSize=1;arcSize=13;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingRight=4;fontSize=15;strokeWidth=1;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="1270" y="1923" width="175" height="55" as="geometry"/></mxCell>
