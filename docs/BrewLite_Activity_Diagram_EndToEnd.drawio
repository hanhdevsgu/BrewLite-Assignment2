<mxCell id="c111" value="19. Thông báo: &quot;Đồ uống&lt;br&gt;sẵn sàng!&quot;" style="rounded=1;absoluteArcSize=1;arcSize=13;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingRight=4;fontSize=15;strokeWidth=1;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="220" y="2005" width="200" height="55" as="geometry"/></mxCell>
