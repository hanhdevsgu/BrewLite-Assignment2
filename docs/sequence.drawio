;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="471" y="1919" as="sourcePoint" /><mxPoint x="98" y="1919" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c68" value="&lt;b&gt;1. Check JWT &amp;amp; Validate DTO&lt;/b&gt;&lt;br&gt;Xác thực Token &amp;amp;&lt;br&gt;lấy user.profileId&lt;br&gt;&amp;amp; ValidationPipe kiểm tra payload" style="shape=note;size=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=4;spacingTop=-3;fillColor=#fff9e6;strokeColor=#666666;fontSize=18;" vertex="1" parent="1"><mxGeometry x="640" y="289" width="300" height="92" as="geometry" /></mxCell><mxCell id="c69" value="&lt;b&gt;2. Sinh Idempotency-Key&lt;/b&gt;&lt;br&gt;Tạo UUIDv4 gắn vào Header" style="shape=note;size=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=4;spacingTop=-3;fillColor=#fff9e6;strokeColor=#666666;fontSize=18;" vertex="1" parent="1"><mxGeometry x="351" y="735" width="250" height="48" as="geometry" /></mxCell><mxCell id="c70" value="&lt;b&gt;3. Check JWT &amp;amp; Validate DTO&lt;/b&gt;&lt;br&gt;Kiểm tra token" style="shape=note;size=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=4;spacingTop=-3;fillColor=#fff9e6;strokeColor=#666666;fontSize=18;" vertex="1" parent="1"><mxGeometry x="700" y="869" width="275" height="48" as="geometry" /></mxCell><mxCell id="c71" value="&lt;b&gt;4a. Xử lý Idempotency Replay&lt;/b&gt;&lt;br&gt;Trả ngay kết quả cũ (KHÔNG trừ tiền/kho lần 2)" style="shape=note;size=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=4;spacingTop=-3;fillColor=#fff2cc;strokeColor=#666666;fontSize=18;" vertex="1" parent="1"><mxGeometry x="796" y="1107" width="500" height="48" as="geometry" /></mxCell><mxCell id="c72" value="&lt;b&gt;4b. State Machine Check&lt;/b&gt;&lt;br&gt;PENDING/FAILED -&amp;gt; PAID" style="shape=note;size=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=4;spacingTop=-3;fillColor=#fff9e6;strokeColor=#666666;fontSize=18;" vertex="1" parent="1"><mxGeometry x="1164" y="1310" width="230" height="48" as="geometry" /></mxCell><mxCell id="c73" value="&lt;b&gt;5. DB Transaction ACID&lt;/b&gt;&lt;br&gt;prisma.$transaction(...)" style="shape=note;size=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=4;spacingTop=-3;fillColor=#e6ffec;strokeColor=#666666;fontSize=18;" vertex="1" parent="1"><mxGeometry x="1261" y="1368" width="332" height="48" as="geometry" /></mxCell><mxCell id="c74" value="&lt;b&gt;6. Gọi Cổng thanh toán&lt;/b&gt;&lt;br&gt;processCharge(WALLET)" style="shape=note;size=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=4;spacingTop=-3;fillColor=#fff9e6;strokeColor=#666666;fontSize=18;" vertex="1" parent="1"><mxGeometry x="1170" y="1599" width="218" height="48" as="geometry" /></mxCell><mxCell id="c75" style="endArrow=none;html=1;dashed=1;dashPattern=1 2;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="27" y="1942" as="sourcePoint" /><mxPoint x="1764" y="1942" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c76" value="[TH 3: Thanh toán thất bại (Hết kho 409 / Gateway từ chối)]" style="text;html=1;align=left;fontStyle=1;fontSize=18;" vertex="1" parent="1"><mxGeometry x="30" y="1946" width="600" height="22" as="geometry" /></mxCell><mxCell id="c77" value="&lt;b&gt;24&lt;/b&gt; Rollback transaction &amp;amp;&lt;br&gt;lưu payment.create(FAILED) /&lt;br&gt;order.update(PAYMENT_FAILED)" style="html=1;endArrow=block;endFill=1;endSize=8;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#000000;strokeWidth=2.5;fontSize=18;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1283" y="2022" as="sourcePoint" /><mxPoint x="1570" y="2022" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c81" value="&lt;b&gt;25&lt;/b&gt; Xác nhận Rollback" style="html=1;endArrow=block;endFill=1;endSize=8;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#000000;strokeWidth=2.5;fontSize=18;dashed=1;dashPattern=2.5 1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1570" y="2056" as="sourcePoint" /><mxPoint x="1283" y="2056" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c78" value="&lt;b&gt;26&lt;/b&gt; HTTP 409 Conflict / 402 Payment Failed" style="html=1;endArrow=block;endFill=1;endSize=8;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#000000;strokeWidth=2.5;fontSize=18;dashed=1;dashPattern=2.5 1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1272" y="2090" as="sourcePoint" /><mxPoint x="817" y="2090" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c79" value="&lt;b&gt;26&lt;/b&gt; HTTP 409 Conflict /&lt;br&gt;402 Payment Failed" style="html=1;endArrow=block;endFill=1;endSize=8;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#000000;strokeWidth=2.5;fontSize=18;dashed=1;dashPattern=2.5 1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="807" y="2116" as="sourcePoint" /><mxPoint x="481" y="2116" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c80" value="&lt;b&gt;27&lt;/b&gt; Hiển thị thông báo lỗi &amp;amp;&lt;br&gt;mời thử thanh toán lại" style="html=1;endArrow=block;endFill=1;endSize=8;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#000000;strokeWidth=2.5;fontSize=18;dashed=1;dashPattern=2.5 1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="471" y="2142" as="sourcePoint" /><mxPoint x="98" y="2142" as="targetPoint" /></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>