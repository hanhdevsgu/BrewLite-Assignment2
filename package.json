{
  "name": "brewlite-monorepo",
  "version": "1.0.0",
  "description": "BrewLite Cashless Coffee Ordering Platform",
  "private": true,
  "scripts": {
    "setup": "node scripts/setup.js",
    "install:all": "npm install && npm --prefix apps/api install && npm --prefix apps/web install",
    "db:setup": "npm --prefix apps/api run prisma:push && npm --prefix apps/api run seed",
    "prisma:studio": "npm --prefix apps/api run prisma:studio",
    "clean:db": "npm --prefix apps/api run clean:orders",
    "recipe": "node apps/api/show-recipes.js",
    "stock": "node apps/api/set-stock.js",
    "dev": "npm run dev:backend",
    "dev:backend": "npm --prefix apps/api run start:dev",
    "dev:frontend": "npm --prefix apps/web run dev",
    "start:frontend": "npm --prefix apps/web start",
    "prod:frontend": "npm run build:frontend && npm --prefix apps/web start",
    "build:backend": "npm --prefix apps/api run build",
    "build:frontend": "npm --prefix apps/web run build",
    "test": "npm --prefix apps/api test --",
    "test:backend": "npm --prefix apps/api test",
    "test:e2e": "npm --prefix apps/api run test:e2e",
    "docker:up": "docker compose up -d postgres",
    "docker:down": "docker compose down",
    "docker:build": "docker compose up --build",
    "tunnel": "node scripts/tunnel.js",
    "phone": "node scripts/tunnel.js",
    "test:race": "node scripts/test-race-condition.js",
    "docker:all": "docker compose up -d"
  },
  "keywords": [
    "coffee",
    "cashless",
    "nestjs",
    "nextjs",
    "prisma",
    "docker"
  ],
  "author": "BrewLite Team",
  "license": "ISC",
  "devDependencies": {
    "qrcode-terminal": "^0.12.0"
  }
}
